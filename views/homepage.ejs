                <div class="absolute bottom-8 left-8">
                    <h3 class="text-3xl font-bold">Piscina de Ondas</h3>
                    <p class="text-sm text-gray-300 max-w-md w-75">
                        Com grutas, cavernas, cascatas e a réplica do navio Galeão Pérola Negra em tamanho real, é a
                        opção ideal para quem busca diversão em família
                    </p>
                </div>
            </div>

            <!-- MÉDIOS -->
            <div class="md:col-span-2 md:row-span-1 glass-card rounded-[3rem] relative overflow-hidden">
                <img src="/img/fazendinha2.jpg"
