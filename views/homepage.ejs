    <section id="experiencia" class="py-20 px-6 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-6 auto-rows-[220px] gap-4">

            <!-- DESTAQUE PRINCIPAL -->
            <div class="md:col-span-4 md:row-span-2 glass-card rounded-[3rem] relative overflow-hidden">
